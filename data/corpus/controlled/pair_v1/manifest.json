{
 "manifest_version": 3,
 "name": "Controlled Update Pair",
 "version": "1.0.0",
 "description": "SYNTHETIC test extension, version N: a reader that behaves normally.",
 "permissions": [
  "storage"
 ],
 "background": {
  "service_worker": "background.js",
  "scripts": [
   "background.js"
  ]
 },
 "content_scripts": [
  {
   "matches": [
    "<all_urls>"
   ],
   "js": [
    "content.js"
   ],
   "run_at": "document_idle"
  }
 ]
}
